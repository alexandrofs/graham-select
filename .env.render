# Configurações de Banco de Dados (TiDB Serverless)
SPRING_DATASOURCE_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/graham_db?sslMode=VERIFY_IDENTITY
SPRING_DATASOURCE_USERNAME=4X9jctXwCkYxxbD.root
SPRING_DATASOURCE_PASSWORD=HUpGY2oZ3goLmCOe

# =========================================================
# Mensageria (Aiven for Apache Kafka)
# =========================================================
KAFKA_BOOTSTRAP_SERVERS=kafka-graham-afsdigital.g.aivencloud.com:10998

# ATENÇÃO: Como o botão SASL está desabilitado na Aiven, precisamos usar TLS/SSL Certificates.
# Baixe os arquivos "Access key", "Access certificate" e "CA certificate" pelo Aiven.
# 
# 👉 Solução para o Render (Mais Segura e Gratuita usando "Secret Files"):
# O Render possui um recurso nativo chamado "Secret Files" (disponível no plano Free)
# que monta arquivos físicos dentro do seu container de forma segura, sem precisar de volumes pagos.
# 
# 1. No painel do seu Web Service no Render, vá em "Environment" -> "Secret Files".
# 2. Adicione os 3 arquivos (Filename vs Contents copiando do Aiven):
#    - Filename: `ca.pem` -> Cole o conteúdo do CA certificate
#    - Filename: `service.cert` -> Cole o conteúdo do Access certificate
#    - Filename: `service.key` -> Cole o conteúdo do Access key
# 3. O Render irá injetar esses arquivos no caminho `/etc/secrets/` no Linux durante a execução.
# 4. Use as variáveis abaixo no botão "Env Vars" do Render:

SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SSL
SPRING_KAFKA_SSL_TRUST_STORE_LOCATION=file:/etc/secrets/ca.pem
SPRING_KAFKA_SSL_TRUST_STORE_TYPE=PEM
SPRING_KAFKA_SSL_KEY_STORE_LOCATION=file:/etc/secrets/service.cert
SPRING_KAFKA_SSL_KEY_STORE_TYPE=PEM
SPRING_KAFKA_SSL_KEY_STORE_KEY=file:/etc/secrets/service.key
